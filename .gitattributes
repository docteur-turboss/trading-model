# Auto detect text files and perform LF normalization
* text=auto

# Husky hooks must stay LF on Windows too (Git Bash needs them)
.husky/** text eol=lf

# Shell scripts run inside Linux containers (ConfigMaps, images)
*.sh text eol=lf

# ConfigMap env files read by kustomize (deploy/k8s/config): a CR would end every value
deploy/k8s/config/*.properties text eol=lf
