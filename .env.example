# =============================================================================
#  .env.example — Environment overrides for docker compose
#  Copy to .env and adjust before running:  docker compose up -d
# =============================================================================

# Node environment
NODE_ENV=production
LOG_LEVEL=info
APP_VERSION=1.0.0
# No INSTANCE_ID here: each service has its own in docker-compose.yml. A shared
# value would make every service share one instance id.

# Port mapping (host : container)
SCRAPER_PORT=8445
TRAINER_PORT=8446
GATEWAY_PORT=8448
EDGE_PORT=8449        # edge-proxy: external HTTP entry to the gateway (/v1)
AUDIT_PORT=8450

# SPIFFE/SPIRE (ADR-0011) — mandatory. mTLS is provided by the spiffe-helper
# sidecars, which write each service SVID into /run/spire/svid (svid.pem,
# svid_key.pem, bundle.pem). No manual certificate generation is required.

# API keys accepted by the gateway (x-api-key), comma-separated, each
# name:scope1+scope2:secret with scope read (ADR-0059). Required:
# with NODE_ENV=production the gateway refuses to start without one.
GATEWAY_AUTH_TOKENS=ops:read:change-me-to-a-long-random-key

# MySQL
MYSQL_ROOT_PASSWORD=
# Password of the application user MYSQL_USER (default scraper), created at first init
MYSQL_PASSWORD=change-me-mysql-app-password
# Read-only MySQL user of mysqld-exporter (required: compose refuses to start
# without it). Characters: [A-Za-z0-9_.@%+=-]
MYSQL_EXPORTER_PASSWORD=change-me-mysql-exporter-password

# MongoDB users (ADR-0067), one per client; required, characters [A-Za-z0-9_.-].
# root: administration and restore; the others have the least rights of their job.
MONGO_ROOT_PASSWORD=change-me-mongo-root-password
MONGO_EXPORTER_PASSWORD=change-me-mongo-exporter-password
MONGO_BACKUP_PASSWORD=change-me-mongo-backup-password
MONGO_AUDIT_PASSWORD=change-me-mongo-audit-password

# Grafana admin password (required, no default: compose refuses to start while empty)
GRAFANA_PASSWORD=
MYSQL_DATABASE=financial_scraper

# Redis (single node for dev/E2E; the compose stack wires REDIS_URL automatically)
# REDIS_URL=redis://redis:6379
# Through Sentinel instead (takes precedence over REDIS_URL): host:port list,
# each host an IP or a DNS name. K8s sets these in the service ConfigMaps.
# REDIS_SENTINELS=redis-sentinel-0.redis-sentinel-headless:26379,10.0.0.7:26379
# REDIS_SENTINEL_MASTER_NAME=mymaster
# REDIS_PASSWORD=
# Compose Redis append-only file: yes by default, no for a disposable stack.
# REDIS_APPENDONLY=yes

# Financial-Scraper — keep SYMBOLS_TO_TRACK aligned with TRAINER_SYMBOLS (JSON array or CSV)
SYMBOLS_TO_TRACK=BTCUSDT,ETHUSDT
SCRAPE_INTERVAL="*/1 * * * *"
# BINANCE_BASE_URL=https://api.binance.com
# Contact e-mail of the signal sources (ADR-0036): the User-Agent is
# "automated news analysis <e-mail>"; SEC EDGAR answers 403 without one.
# Use a functional, non-nominative address (project alias, never a person's).
# Keep the real one in .env only: the repository is public.
SIGNAL_CONTACT_EMAIL=
# Free EIA open data key (eia.gov/opendata/register.php); without it only the EIA source is off.
SIGNAL_KEY_EIA=
SIGNAL_KEY_FRED=
# Free Twelve Data key (https://twelvedata.com, ADR-0080); empty: daily prices not collected.
SIGNAL_KEY_TWELVEDATA=
# Ids of non-commercial sources you accept to collect (ADR-0075), e.g. twelvedata-daily-prices.
# In production financial-scraper refuses to start with such a source active and not listed.
SIGNAL_NON_COMMERCIAL_ACCEPTED=

# Trader-Trainer
TRAINER_SYMBOLS=BTCUSDT,ETHUSDT
TRAINER_DATA_WINDOW=500
# Validation = fraction of the steps left after the test cut
TRAINER_VALIDATION_SPLIT=0.15
TRAINER_TEST_SPLIT=0.15
TRAINER_GENERATIONS=50
TRAINER_POPULATION_SIZE=20
TRAINER_TIME_BUDGET_MS=300000
TRAINER_INTERVAL_MS=14400000
TRAINER_MAX_DATA_AGE_MS=900000
TRAINER_EPISODES_PER_INDIVIDUAL=10
# GA scalar fitness (ADR-0025): total_pnl | sharpe | sortino | calmar | composite
TRAINER_FITNESS_TYPE=total_pnl
# Feature flag (ADR-0039): false forces total_pnl whatever TRAINER_FITNESS_TYPE says
FEATURE_RISK_ADJUSTED_FITNESS=true
# Feature flag (ADR-0039): true lets the GA choose the action space (partial order sizes)
FEATURE_ACTION_SPACE_GENE=false
# Feature flag (ADR-0039): true feeds the TRAINER_SIGNAL_FEATURES signals to the network (ADR-0081)
FEATURE_SIGNAL_INPUTS=false
# SUBJECT:dimension:metric list, e.g. BTC:social:pageviews; the subject must be the session asset (TRAINER_SYMBOL_ASSETS)
TRAINER_SIGNAL_FEATURES=
# Show the agent its position (ADR-0025); false to compare during MT4
TRAINER_OBSERVE_POSITION=true
# Services allowed to download trained model weights (ADR-0022), comma-separated.
# Empty: nobody (the metadata stays readable through the API).
MODEL_DOWNLOAD_CALLERS=model-evaluator,decision-consumer

# Custom DNS name to address mapping (JSON object, optional)
# Overrides Docker Compose service hostnames for non-Docker environments
# Example: {"audit-logger":"127.0.0.1","financial-scraper":"192.168.1.50"}
DNS_NAME_MAP={}

# Alertmanager notification credentials: a directory with one file per key
# (SLACK_WEBHOOK_URL, PUSHOVER_USER_KEY, PUSHOVER_TOKEN, DEADMAN_URL), see deploy/k8s/infra/config/alertmanager.yml
# ALERTMANAGER_CREDENTIALS_DIR=./observability/alertmanager-credentials

