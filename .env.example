# =============================================================================
#  .env.example — Environment overrides for docker compose
#  Copy to .env and adjust before running:  docker compose up -d
# =============================================================================

# Node environment
NODE_ENV=production
LOG_LEVEL=info
APP_VERSION=1.0.0
# No INSTANCE_ID here: each service has its own in docker-compose.yml. A shared
# value makes every service register as the same discovery instance.

# Port mapping (host : container)
DISCOVERY_PORT=8443
MESSAGE_PORT=8444
SCRAPER_PORT=8445
TRAINER_PORT=8446
GATEWAY_PORT=8448
EDGE_PORT=8449        # edge-proxy: external HTTP entry to the gateway (/v1)
AUDIT_PORT=8450
DLQ_PORT=8452

# SPIFFE/SPIRE (ADR-0011) — mandatory. mTLS is provided by the spiffe-helper
# sidecars, which write each service SVID into /run/spire/svid (svid.pem,
# svid_key.pem, bundle.pem). No manual certificate generation is required.

# Enforce the service-to-service ACL on attested SVID identities (ADR-0011).
# Set to "false" only for local debugging without a full SPIRE stack.
# ENFORCE_MTLS_STRICT=true

# API keys accepted by the gateway (x-api-key), comma-separated. Required:
# with NODE_ENV=production the gateway refuses to start without one.
GATEWAY_AUTH_TOKENS=change-me-to-a-long-random-key

# HMAC secret of the discovery instance tokens (kept in Redis). Required: with
# NODE_ENV=production discovery refuses to start without one. A random secret
# per process would reject every token after a restart. openssl rand -hex 32
SIGNING_SECRET=change-me-to-a-long-random-secret

# MySQL
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=financial_scraper

# Redis (single node for dev/E2E; the compose stack wires REDIS_URL automatically)
# REDIS_URL=redis://redis:6379
# Through Sentinel instead (takes precedence over REDIS_URL): host:port list,
# each host an IP or a DNS name. K8s sets these in the service ConfigMaps.
# REDIS_SENTINELS=redis-sentinel-0.redis-sentinel-headless:26379,10.0.0.7:26379
# REDIS_SENTINEL_MASTER_NAME=mymaster
# REDIS_PASSWORD=
# Compose Redis append-only file: no for development, yes on a compose host
# running staging/production (K8s always runs it with AOF on).
# REDIS_APPENDONLY=no

# DLQ service (HMAC auth for inter-service requests). message-manager signs
# its dead letters with the same secret (compose default: test-hmac-secret).
# DLQ_AUTH_HMAC_SECRET=change-me-to-a-secret-of-at-least-16-chars
# DLQ_ALLOWED_SERVICES=message-manager,admin

# Financial-Scraper — keep SYMBOLS_TO_TRACK aligned with TRAINER_SYMBOLS (JSON array or CSV)
SYMBOLS_TO_TRACK=BTCUSDT,ETHUSDT
SCRAPE_INTERVAL="*/1 * * * *"
# BINANCE_BASE_URL=https://api.binance.com
# Contact e-mail of the signal sources (ADR-0036): the User-Agent is
# "automated news analysis <e-mail>"; SEC EDGAR answers 403 without one.
# Keep the real one in .env only: the repository is public.
SIGNAL_CONTACT_EMAIL=

# Trader-Trainer
TRAINER_SYMBOLS=BTCUSDT,ETHUSDT
TRAINER_DATA_WINDOW=500
TRAINER_VALIDATION_SPLIT=0.2
TRAINER_GENERATIONS=50
TRAINER_POPULATION_SIZE=20
TRAINER_TIME_BUDGET_MS=300000
TRAINER_MAX_DATA_AGE_MS=900000
TRAINER_EPISODES_PER_INDIVIDUAL=10
# GA scalar fitness (ADR-0025): total_pnl | sharpe | sortino | calmar | composite
TRAINER_FITNESS_TYPE=total_pnl
# Feature flag (ADR-0039): false forces total_pnl whatever TRAINER_FITNESS_TYPE says
FEATURE_RISK_ADJUSTED_FITNESS=true
# Show the agent its position (ADR-0025); false to compare during MT4
TRAINER_OBSERVE_POSITION=true
# Services allowed to download trained model weights (ADR-0022), comma-separated.
# Empty: nobody (the metadata stays readable through the API).
MODEL_DOWNLOAD_CALLERS=

# Custom DNS name to address mapping (JSON object, optional)
# Overrides Docker Compose service hostnames for non-Docker environments
# Example: {"message-manager":"127.0.0.1","financial-scraper":"192.168.1.50"}
DNS_NAME_MAP={}

# Alertmanager notification credentials: a directory with one file per key
# (SLACK_WEBHOOK_URL, PUSHOVER_USER_KEY, PUSHOVER_TOKEN, DEADMAN_URL), see observability/alertmanager.yml
# ALERTMANAGER_CREDENTIALS_DIR=./observability/alertmanager-credentials

# Backup directory of scripts/backup.sh (run by the host scheduler); its metrics/
# subdirectory is served to Prometheus by backup-metrics-exporter
# BACKUP_DIR=./backups
