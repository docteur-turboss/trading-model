      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "@trading-model/common": "*",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/node-forge": "^1.3.11",
    "typescript": "^6.0.3",
    "@jest/globals": "^30.4.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "globals": "^17.6.0"
  },
  "scripts": {
    "test": "jest",
    "test:detectOpenHandles": "jest --detectOpenHandles",
    "test:coverage": "jest --coverage",
    "build": "tsc -p tsconfig.build.json"
