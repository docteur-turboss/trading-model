{
  "name": "@trading-model/certificate-utils",
  "version": "1.0.0",
  "description": "Certificate generation and management utilities",
  "license": "ISC",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
