{
  "name": "@trading-model/persistence",
  "version": "1.0.0",
  "description": "Persistence adapters (Redis/Mongo connection managers, store adapters, key builders) extracted from @trading-model/common",
  "license": "ISC",
  "type": "commonjs",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "@trading-model/common": "*",
    "@trading-model/primitives": "*",
    "@trading-model/contracts": "*",
    "ioredis": "^6.0.0",
    "mongodb": "^7.8.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:db": "NODE_OPTIONS=--experimental-vm-modules jest -c jest.db.config.js",
    "build": "tsc"
  }
}