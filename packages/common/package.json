{
  "name": "@trading-model/common",
  "version": "1.2.1",
  "description": "Shared infrastructure (config, utils, shared schemas) extracted from the former god-package",
  "license": "ISC",
  "type": "commonjs",
  "exports": {
    "./config/*": {
      "types": "./dist/config/*.d.ts",
      "default": "./dist/config/*.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "default": "./dist/utils/*.js"
    },
    "./shared/*": {
      "types": "./dist/shared/*.d.ts",
      "default": "./dist/shared/*.js"
    },
    "./tests/*": {
      "types": "./tests/*.d.ts",
      "default": "./tests/*.js"
    }
  },
  "dependencies": {
    "@trading-model/contracts": "*",
    "@trading-model/primitives": "*",
    "chained-error": "^1.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "test": "jest",
    "test:detectOpenHandles": "jest --detectOpenHandles",
    "test:coverage": "jest --coverage",
    "build": "tsc"
  }
}
