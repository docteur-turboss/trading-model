{
  "name": "@trading-model/address-manager",
  "version": "1.2.0",
  "description": "Address management and service discovery client",
  "license": "ISC",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "@trading-model/primitives": "*",
    "@trading-model/contracts": "*",
    "@trading-model/common": "*",
    "@trading-model/persistence": "*",
    "@trading-model/http": "*",
    "@trading-model/reliability": "*",
    "@trading-model/server-utils": "*",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "node-cron": "^4.6.0",
    "prom-client": "^15.1.3",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "test": "jest",
    "test:detectOpenHandles": "jest --detectOpenHandles",
    "test:coverage": "jest --coverage",
