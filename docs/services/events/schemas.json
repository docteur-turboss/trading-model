	"market.order-book.snapshot.fetch": {
		"$schema": "https://json-schema.org/draft/2020-12/schema",
		"type": "object",
		"properties": {
			"orderBook": {
				"type": "array",
				"items": {
					"type": "object",
					"properties": {
						"bids": {
							"anyOf": [
								{},
								{
									"type": "array",
									"items": {
										"type": "object",
										"properties": {
											"price": {
												"type": "number"
											},
											"quantity": {
												"type": "number"
											}
										},
										"required": [
											"price",
											"quantity"
										]
									}
								}
							]
						},
						"asks": {
							"anyOf": [
								{},
								{
									"type": "array",
									"items": {
										"type": "object",
										"properties": {
											"price": {
												"type": "number"
											},
											"quantity": {
												"type": "number"
											}
										},
										"required": [
											"price",
											"quantity"
										]
									}
								}
							]
						},
						"symbol": {
							"type": "string"
						},
						"timestamp": {
							"type": "number"
						},
						"source": {
							"type": "string",
							"enum": [
								"bloomberg",
								"binance",
								"nyse"
							]
						},
						"market": {
							"type": "string",
							"enum": [
								"crypto",
								"equity",
								"bond",
								"etf",
								"fx",
								"future"
							]
						}
					},
					"required": [
						"bids",
						"asks",
						"symbol",
						"timestamp",
						"source",
						"market"
					]
				}
			}
		},
		"required": [
			"orderBook"
		]
	},
	"market.price-ticker.snapshot.fetch": {
		"$schema": "https://json-schema.org/draft/2020-12/schema",
		"type": "object",
		"properties": {
			"price": {
				"type": "object",
				"propertyNames": {
					"type": "string"
				},
				"additionalProperties": {
					"type": "number"
				}
			}
		},
		"required": [
			"price"
		]
	},
	"market.ticker.24hr-stats.fetch": {
		"$schema": "https://json-schema.org/draft/2020-12/schema",
		"type": "object",
		"properties": {
			"ticker": {
				"type": "array",
				"items": {
					"type": "object",
					"properties": {
						"low": {
							"type": "number"
						},
						"open": {
							"type": "number"
						},
						"high": {
							"type": "number"
						},
						"last": {
							"type": "number"
						},
						"volume": {
							"type": "number"
						},
						"closeTimestamp": {
							"type": "number"
						},
						"symbol": {
							"type": "string"
						},
						"timestamp": {
							"type": "number"
						},
						"source": {
							"type": "string",
							"enum": [
								"bloomberg",
								"binance",
								"nyse"
							]
						},
						"market": {
							"type": "string",
							"enum": [
								"crypto",
								"equity",
								"bond",
								"etf",
								"fx",
								"future"
							]
						}
					},
					"required": [
						"low",
						"open",
						"high",
						"last",
						"volume",
						"closeTimestamp",
						"symbol",
						"timestamp",
						"source",
						"market"
					]
				}
			}
		},
		"required": [
			"ticker"
		]
	},
	"market.trade.recent.fetch": {
		"$schema": "https://json-schema.org/draft/2020-12/schema",
		"type": "object",
		"properties": {
			"trades": {
				"type": "array",
				"items": {
					"type": "object",
					"properties": {
						"price": {
							"type": "number"
						},
						"tradeId": {
							"anyOf": [
								{},
								{
									"type": "string",
									"pattern": "^\\d+$"
								}
							]
						},
						"quantity": {
							"type": "number"
						},
						"side": {
							"type": "string",
							"enum": [
								"buy",
								"sell"
							]
						},
						"symbol": {
							"type": "string"
						},
						"timestamp": {
							"type": "number"
						},
						"source": {
							"type": "string",
							"enum": [
								"bloomberg",
								"binance",
								"nyse"
							]
						},
						"market": {
							"type": "string",
							"enum": [
								"crypto",
								"equity",
								"bond",
								"etf",
								"fx",
								"future"
							]
						}
					},
					"required": [
						"price",
						"tradeId",
						"quantity",
						"side",
						"symbol",
						"timestamp",
						"source",
						"market"
					]
				}
			}
		},
		"required": [
			"trades"
		]
	}
}
