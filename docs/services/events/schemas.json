	"market.trade.recent.fetch": {
		"$schema": "https://json-schema.org/draft/2020-12/schema",
		"type": "object",
		"properties": {
			"trades": {
				"type": "array",
				"items": {
					"type": "object",
					"properties": {
						"price": {
							"type": "number"
						},
						"tradeId": {
							"anyOf": [
								{},
								{
									"type": "string",
									"pattern": "^\\d+$"
								}
							]
						},
						"quantity": {
							"type": "number"
						},
						"side": {
							"type": "string",
							"enum": [
								"buy",
								"sell"
							]
						},
						"symbol": {
							"type": "string"
						},
						"timestamp": {
							"type": "number"
						},
						"source": {
							"type": "string",
							"enum": [
								"bloomberg",
								"binance",
								"nyse"
							]
						},
						"market": {
							"type": "string",
							"enum": [
								"crypto",
								"equity",
								"bond",
								"etf",
								"fx",
								"future"
							]
						}
					},
					"required": [
						"price",
						"tradeId",
						"quantity",
						"side",
						"symbol",
						"timestamp",
						"source",
						"market"
					]
				}
			}
		},
		"required": [
			"trades"
		]
	},
	"training.model.published": {
		"$schema": "https://json-schema.org/draft/2020-12/schema",
		"type": "object",
		"properties": {
			"symbol": {
				"type": "string",
				"minLength": 1
			},
			"generation": {
				"type": "number"
			},
			"fitness": {
				"type": "number"
			},
			"sharpe": {
				"type": "number"
			},
			"avgPnl": {
				"type": "number"
			},
			"maxDrawdown": {
				"type": "number",
				"minimum": 0
			},
			"evaluatedOn": {
				"type": "string",
				"enum": [
					"validation",
					"test"
				]
			},
			"agentId": {
				"type": "string"
			},
			"version": {
				"type": "string",
				"minLength": 1
			},
			"sha256": {
				"type": "string",
				"pattern": "^[0-9a-f]{64}$"
			},
			"admissible": {
				"type": "boolean"
			},
			"gaControl": {
				"type": "object",
				"properties": {
					"populationSize": {
						"type": "number"
					},
					"elitismFraction": {
						"type": "number"
					},
					"survivorFraction": {
						"type": "number"
					},
					"episodesPerIndividual": {
						"type": "number"
					},
					"selectionType": {
						"type": "string"
					},
					"fitnessType": {
						"type": "string"
					}
				},
				"required": [
					"populationSize",
					"elitismFraction",
					"survivorFraction",
					"episodesPerIndividual",
					"selectionType",
					"fitnessType"
				]
			},
			"network": {
				"type": "object",
				"properties": {
					"inputDim": {
						"type": "number"
					},
					"outputDim": {
						"type": "number"
					},
					"hiddenLayers": {
						"type": "array",
						"items": {
							"type": "object",
							"properties": {
								"neurons": {
									"type": "number"
								},
								"activation": {
									"type": "string"
								}
							},
							"required": [
								"neurons",
								"activation"
							]
						}
					}
				},
				"required": [
					"inputDim",
					"outputDim",
					"hiddenLayers"
				]
			},
			"rl": {
				"type": "object",
				"properties": {
					"gamma": {
						"type": "number"
					},
					"learningRate": {
						"type": "number"
					},
					"epsilonStart": {
						"type": "number"
					},
					"epsilonMin": {
						"type": "number"
					},
					"epsilonDecay": {
						"type": "number"
					}
				},
				"required": [
					"gamma",
					"learningRate",
					"epsilonStart",
					"epsilonMin",
					"epsilonDecay"
				]
			}
		},
		"required": [
			"symbol",
			"generation",
			"fitness",
			"sharpe",
			"avgPnl",
			"maxDrawdown",
			"evaluatedOn",
			"agentId",
			"gaControl",
			"network",
			"rl"
		]
	}
}
