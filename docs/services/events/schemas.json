	"market.candlestick.series.fetch": {
		"$schema": "https://json-schema.org/draft/2020-12/schema",
		"type": "object",
		"properties": {
			"candle": {
				"type": "array",
				"items": {
					"type": "object",
					"properties": {
						"low": {
							"type": "number"
						},
						"open": {
							"type": "number"
						},
						"high": {
							"type": "number"
						},
						"close": {
							"type": "number"
						},
						"volume": {
							"type": "number"
						},
						"trades": {
							"type": "number"
						},
						"interval": {
							"type": "string",
							"enum": [
								"1s",
								"1m",
								"3m",
								"5m",
								"15m",
								"30m",
								"1h",
								"2h",
								"4h",
								"6h",
								"8h",
								"12h",
								"1d",
								"3d",
								"1w",
								"1M"
							]
						},
						"closeTimestamp": {
							"type": "number"
						},
						"symbol": {
							"type": "string"
						},
						"timestamp": {
							"type": "number"
						},
						"source": {
							"type": "string",
							"enum": [
								"bloomberg",
								"binance",
								"nyse"
							]
						},
						"market": {
							"type": "string",
							"enum": [
								"crypto",
								"equity",
								"bond",
								"etf",
								"fx",
								"future"
							]
						}
					},
					"required": [
						"low",
						"open",
						"high",
						"close",
						"volume",
						"interval",
						"closeTimestamp",
						"symbol",
						"timestamp",
						"source",
						"market"
					]
				}
			}
		},
		"required": [
			"candle"
		]
	},
