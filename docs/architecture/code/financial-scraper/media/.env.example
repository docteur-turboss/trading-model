# Application
NODE_ENV="development"
APP_NAME="financial-scraper"
APP_VERSION="1.0.0"
PORT=8444
LOG_LEVEL="info"

# TLS / mTLS (SPIRE SVIDs)
TLS_KEY_PATH="/run/spire/svid/svid_key.pem"
TLS_CERT_PATH="/run/spire/svid/svid.pem"
TLS_CA_PATH="/run/spire/svid/bundle.pem"

# Service Discovery
SERVICE_NAME="financial-scraper"
INSTANCE_ID="uuid"
ADDRESS_MANAGER_URL="https://discovery-server:8443"
CACHE_TTL_MS=84000000
SERVICE_PING_TIMEOUT_MS=84000000
TOKEN_REFRESH_INTERVAL_MS=84000000
TTL_REFRESH_INTERVAL_MS=84000000

# Message Bus
MESSAGE_BUS_INIT_TIMEOUT_MS=84000000
MESSAGE_BUS_SHUTDOWN_TIMEOUT_MS=84000000
MESSAGE_CALLBACK_PATH="message"

# Database (MySQL)
DB_USER="root"
DB_PASSWORD="changeme"
DB_NAME="financial_scraper"
DB_HOST="localhost"
DB_PORT=3306

# Binance API (optional — public endpoints do not require credentials)
# BINANCE_API_KEY="your-api-key"
# BINANCE_API_SECRET="your-api-secret"

# Scraper
SYMBOLS_TO_TRACK='["BTCUSDT","ETHUSDT"]'
SCRAPE_INTERVAL="*/1 * * * *"

# Monitoring
ERROR_URL_WEBHOOK="https://hooks.example.com/error-webhook"