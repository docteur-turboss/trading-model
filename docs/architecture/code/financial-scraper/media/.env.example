# Application
NODE_ENV="development"
APP_NAME="financial-scraper:instance-1"
APP_VERSION="1.0.0"
PORT=8444
LOG_LEVEL="info"

# TLS / mTLS
TLS_KEY_PATH="server-key.pem"
TLS_CERT_PATH="server.crt"
TLS_CA_PATH="ca.crt"

# Service Discovery
SERVICE_NAME="financial-scraper-service"
INSTANCE_ID="uuid"
ADDRESS_MANAGER_URL="https://discovery-server:8443"
CACHE_TTL_MS=84000000
SERVICE_PING_TIMEOUT_MS=84000000
TOKEN_REFRESH_INTERVAL_MS=84000000
TTL_REFRESH_INTERVAL_MS=84000000

# Message Bus
MESSAGE_BUS_INIT_TIMEOUT_MS=84000000
MESSAGE_BUS_SHUTDOWN_TIMEOUT_MS=84000000
MESSAGE_CALLBACK_PATH="message"

# Database (MySQL)
DB_USER="root"
DB_PASSWORD="changeme"
DB_NAME="financial_scraper"
DB_HOST="localhost"
DB_PORT=3306

# Monitoring
ERROR_URL_WEBHOOK="https://hooks.example.com/error-webhook"