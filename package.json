{
  "name": "trading-model",
  "version": "3.1.0-rc.1",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "tests/*"
  ],
  "scripts": {
    "build:primitives": "bun run --filter @trading-model/primitives build",
    "build:contracts": "bun run --filter @trading-model/contracts build",
    "build:reliability": "bun run --filter @trading-model/reliability build",
    "build:common": "bun run --filter @trading-model/common build",
    "build:persistence": "bun run --filter @trading-model/persistence build",
    "build:http": "bun run --filter @trading-model/http build",
    "build:crypto": "bun run --filter @trading-model/crypto build",
    "build:validation": "bun run --filter @trading-model/validation build",
    "build:server-utils": "bun run --filter @trading-model/server-utils build",
    "build:address-manager": "bun run --filter @trading-model/address-manager build",
    "build:broker-message": "bun run --filter @trading-model/broker-message build",
    "build:api-gateway": "bun run --filter api-gateway build",
    "build:audit-logger": "bun run --filter audit-logger build",
    "build": "bun run build:primitives && bun run build:contracts && bun run build:reliability && bun run build:common && bun run build:persistence && bun run build:http && bun run build:validation && bun run build:server-utils && bun run build:crypto && bun run build:address-manager && bun run build:broker-message",
    "build:ts": "bun run build && bun run --filter message-manager build && bun run --filter discovery-server build && bun run --filter financial-scraper build && bun run --filter trader-service build && bun run --filter api-gateway build && bun run --filter audit-logger build && bun run --filter dlq-service build",
    "commit": "bun scripts/commit.mjs",
    "release": "bun scripts/release.mjs",
    "release:dry": "bun scripts/release.mjs --dry-run",
    "release:bump": "bun scripts/release.mjs --bump",
    "release:version": "bun scripts/release.mjs --version",
    "release:publish": "bun scripts/release.mjs --publish",
    "release:test": "node --test tests/release/release.test.mjs",
    "lint": "bunx @biomejs/biome check .",
    "lint:fix": "bunx @biomejs/biome check . --write",
    "deps:check": "node scripts/check-deps.mjs",
    "deps:third-party": "knip --include dependencies,exports,types",
    "typecheck:tests": "node scripts/typecheck-tests.mjs",
    "api:check": "bun --tsconfig-override=scripts/api-contract.tsconfig.json scripts/api-contract.mjs",
    "contracts:check": "bun --tsconfig-override=scripts/api-contract.tsconfig.json scripts/message-schemas.mjs && node --test scripts/schema-compat.test.mjs",
    "contracts:write": "bun --tsconfig-override=scripts/api-contract.tsconfig.json scripts/message-schemas.mjs --write",
    "contracts:compat": "bun --tsconfig-override=scripts/api-contract.tsconfig.json scripts/message-schemas.mjs --compat",
    "adr:check": "node scripts/adr-check.mjs",
    "api:write": "bun --tsconfig-override=scripts/api-contract.tsconfig.json scripts/api-contract.mjs --write",
    "reach:report": "node scripts/reachability.mjs",
    "reach:check": "node scripts/reachability.mjs --max-lines 0",
    "arch:check": "node --test tests/architecture/architecture-check.test.mjs && node scripts/architecture-check.mjs",
    "config:check": "node scripts/config-flags-check.mjs",
    "env-protection:test": "node --test scripts/check-environment-protection.test.mjs",
    "preflight:test": "node --test scripts/preflight-summary.test.mjs",
    "compliance:check": "node scripts/compliance-check.mjs && node --test scripts/compliance-check.test.mjs",
    "compose-ports:check": "node scripts/compose-ports-check.mjs && node --test scripts/compose-ports-check.test.mjs",
    "test": "bun run --filter '*' test",
    "test:coverage": "bun run --filter '*' test --coverage",
    "test:db": "bun run --filter '*' test:db",
    "test:db:coverage": "bun run --filter '*' test:db --coverage",
    "test:contract": "bun run --filter trading-model-contract-tests test:contract",
    "test:e2e": "bun run --filter trading-model-e2e test:e2e",
    "test:e2e:docker": "bun run --filter trading-model-e2e test:docker",
    "docs:generate": "typedoc",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@commitlint/cli": "^21.2.4",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/jest-runner": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@testcontainers/mongodb": "^12.2.1",
    "@testcontainers/mysql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "husky": "^9.1.7",
    "knip": "6.44.2",
    "testcontainers": "^12.2.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "qs": "^6.17.1",
    "glob": "^14.0.4",
    "minimatch": "^11.0.8",
    "typedoc": {
      "minimatch": "^10.2.5"
    }
  }
}
