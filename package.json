{
  "name": "trading-model",
  "version": "2.0.3",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build:common": "npm run -w @trading-model/common build",
    "build:crypto": "npm run -w @trading-model/crypto build",
    "build:validation": "npm run -w @trading-model/validation build",
    "build:server-utils": "npm run -w @trading-model/server-utils build",
    "build:address-manager": "npm run -w @trading-model/address-manager build",
    "build:broker-message": "npm run -w @trading-model/broker-message build",
    "build:certificate-utils": "npm run -w @trading-model/certificate-utils build",
		"build:certificate-client": "npm run -w @trading-model/certificate-client build",
    "build:certificate-authority": "npm run -w certificate-authority build",
    "build:api-gateway": "npm run -w api-gateway build",
    "build:audit-logger": "npm run -w audit-logger build",
    "build:admin": "npm run -w admin-interface build",
    "dev:admin": "npm run -w admin-interface dev",
    "test:admin": "npm run -w admin-interface test",
    "lint:admin": "npm run -w admin-interface lint",
    "build": "npm run build:common && npm run build:validation && npm run build:server-utils && npm run build:crypto && npm run build:address-manager && npm run build:broker-message && npm run build:certificate-utils && npm run build:certificate-client",
    "build:ts": "npm run build && npm run -w services/message-manager build && npm run -w services/discovery-server build && npm run -w services/financial-scraper build && npm run -w services/trader-trainer build && npm run -w services/certificate-authority build && npm run -w services/api-gateway build && npm run -w services/audit-logger build && npm run -w services/admin-interface build",
    "commit": "node scripts/commit.mjs",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "release:bump": "node scripts/release.mjs --bump",
    "release:version": "node scripts/release.mjs --version",
    "release:publish": "node scripts/release.mjs --publish",
    "lint": "npx @biomejs/biome check .",
    "test": "npm test --workspaces",
    "test:coverage": "npm test --workspaces -- --coverage",
    "docs:generate": "node scripts/generate-docs.mjs",
    "docs:generate:dry": "node scripts/generate-docs.mjs --dry-run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.1",
    "conventional-commits-filter": "^5.0.0",
    "conventional-commits-parser": "^6.4.0",
    "husky": "^9.1.7",
    "typedoc": "^0.28.19"
  }
}
