{
  "name": "trading-model",
  "version": "1.3.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build:common": "npm run -w @trading-model/common build",
    "build:address-manager": "npm run -w @trading-model/address-manager build",
    "build:broker-message": "npm run -w @trading-model/broker-message build",
    "build": "npm run build:common && npm run build:address-manager && npm run build:broker-message",
    "commit": "node scripts/commit.mjs",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "lint": "npx eslint . --ext .ts,.js,.mjs,.cjs",
    "eslint": "npx eslint src/**/*.{ts,js}",
    "test": "npm test --workspaces --if-present",
    "test:coverage": "npm test --workspaces --if-present -- --coverage",
    "docs:generate": "node scripts/generate-docs.mjs",
    "docs:generate:dry": "node scripts/generate-docs.mjs --dry-run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "conventional-commits-filter": "^5.0.0",
    "conventional-commits-parser": "^6.4.0",
    "husky": "^9.1.7",
    "typedoc": "^0.28.19"
  }
}
