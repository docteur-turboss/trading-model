{
  "name": "trading-model",
  "version": "2.0.3",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build:common": "bun run --filter @trading-model/common build",
    "build:crypto": "bun run --filter @trading-model/crypto build",
    "build:validation": "bun run --filter @trading-model/validation build",
    "build:server-utils": "bun run --filter @trading-model/server-utils build",
    "build:address-manager": "bun run --filter @trading-model/address-manager build",
    "build:broker-message": "bun run --filter @trading-model/broker-message build",
    "build:api-gateway": "bun run --filter api-gateway build",
    "build:audit-logger": "bun run --filter audit-logger build",
    "build:admin": "bun run --filter admin-interface build",
    "dev:admin": "bun run --filter admin-interface dev",
    "test:admin": "bun run --filter admin-interface test",
    "lint:admin": "bun run --filter admin-interface lint",
    "build": "bun run build:common && bun run build:validation && bun run build:server-utils && bun run build:crypto && bun run build:address-manager && bun run build:broker-message",
    "build:ts": "bun run build && bun run --filter message-manager build && bun run --filter discovery-server build && bun run --filter financial-scraper build && bun run --filter trader-service build && bun run --filter api-gateway build && bun run --filter audit-logger build && bun run --filter dlq-service build && bun run --filter admin-interface build",
    "commit": "bun scripts/commit.mjs",
    "release": "bun scripts/release.mjs",
    "release:dry": "bun scripts/release.mjs --dry-run",
    "release:bump": "bun scripts/release.mjs --bump",
    "release:version": "bun scripts/release.mjs --version",
    "release:publish": "bun scripts/release.mjs --publish",
    "lint": "bunx @biomejs/biome check .",
    "test": "bun run --filter '*' test",
    "test:coverage": "bun run --filter '*' test --coverage",
    "docs:generate": "bun scripts/generate-docs.mjs",
    "docs:generate:dry": "bun scripts/generate-docs.mjs --dry-run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.1",
    "conventional-commits-filter": "^5.0.0",
    "conventional-commits-parser": "^6.4.0",
    "husky": "^9.1.7",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@adobe/css-tools": "^4.5.0",
    "@asamuzakjp/css-color": "^6.0.7",
    "@asamuzakjp/dom-selector": "^8.3.2"
  }
}
