# =============================================================================
# Admin Interface — Environment Variables
# =============================================================================

# API Gateway URL (default: /v1 — proxied by Vite dev server or nginx)
# In production, this is handled by the nginx reverse proxy.
# VITE_API_GATEWAY_URL=/v1

# Admin authentication token (sent as x-api-key header)
# Must match the token configured in api-gateway.
# VITE_ADMIN_TOKEN=
