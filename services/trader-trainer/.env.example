# ── Runtime ──────────────────────────────────────────
NODE_ENV=development
PORT=8446
LOG_LEVEL=info

# ── TLS / mTLS ──────────────────────────────────────
TLS_KEY_PATH=./certs/server-key.pem
TLS_CERT_PATH=./certs/server.crt
TLS_CA_PATH=./certs/ca.crt

# ── Service Identity ─────────────────────────────────
APP_NAME=trader-trainer
APP_VERSION=1.0.0
SERVICE_NAME=trader-trainer-service
INSTANCE_ID=trader-trainer-1

# ── Certificate Auto-Provisioning (CA client) ───────
# Uncomment to enable automatic TLS certificate bootstrap from the CA:
# CERT_CLIENT_CA_URL=https://certificate-authority:8447
# CERT_CLIENT_SERVICE_ID=trader-trainer
# CERT_CLIENT_COMMON_NAME=trader-trainer
# CERT_CLIENT_SANS=trader-trainer,localhost
# CERT_CLIENT_BOOTSTRAP_TOKEN=

# ── Service Discovery ───────────────────────────────
ADDRESS_MANAGER_URL=https://discovery-server:3000
CACHE_TTL_MS=30000
SERVICE_PING_TIMEOUT_MS=2000
DISCOVERY_TIMEOUT_MS=5000
TOKEN_REFRESH_INTERVAL_MS=60000
TTL_REFRESH_INTERVAL_MS=15000
ERROR_URL_WEBHOOK=
MESSAGE_BUS_INIT_TIMEOUT_MS=2000
MESSAGE_BUS_SHUTDOWN_TIMEOUT_MS=2000
MESSAGE_CALLBACK_PATH=message

# ── Training Configuration ──────────────────────────
TRAINER_SYMBOLS=BTCUSDT,ETHUSDT
TRAINER_DATA_WINDOW=500
TRAINER_VALIDATION_SPLIT=0.2
TRAINER_GENERATIONS=50
TRAINER_POPULATION_SIZE=20
TRAINER_TIME_BUDGET_MS=300000
TRAINER_EPISODES_PER_INDIVIDUAL=3
