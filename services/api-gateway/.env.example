# ── Runtime ──────────────────────────────────────────
NODE_ENV=development
PORT=8443
LOG_LEVEL=info

# ── TLS / mTLS ──────────────────────────────────────
TLS_KEY_PATH=./certs/server-key.pem
TLS_CERT_PATH=./certs/server.crt
TLS_CA_PATH=./certs/ca.crt

# ── Service Identity ─────────────────────────────────
APP_NAME=api-gateway
APP_VERSION=1.0.0
INSTANCE_ID=api-gateway-1
SERVICE_NAME=api-gateway-service

# ── Certificate Auto-Provisioning (CA client) ───────
# Uncomment to enable automatic TLS certificate bootstrap from the CA:
# CERT_CLIENT_CA_URL=https://certificate-authority:8447
# CERT_CLIENT_SERVICE_ID=api-gateway
# CERT_CLIENT_COMMON_NAME=api-gateway
# CERT_CLIENT_SANS=api-gateway,localhost
# CERT_CLIENT_BOOTSTRAP_TOKEN=

# ── Service Discovery ───────────────────────────────
ADDRESS_MANAGER_URL=https://discovery-server:3000
CACHE_TTL_MS=30000
SERVICE_PING_TIMEOUT_MS=2000
TOKEN_REFRESH_INTERVAL_MS=60000
TTL_REFRESH_INTERVAL_MS=15000

# ── Rate Limiting ───────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ── Auth ────────────────────────────────────────────
AUTH_TOKEN_HEADER=x-api-key
# Comma-separated list of valid API tokens:
AUTH_TOKENS=change-me-in-production

# ── Proxy ───────────────────────────────────────────
PROXY_TIMEOUT_MS=10000
