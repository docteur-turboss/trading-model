{
  "compilerOptions": {
    "target": "es2020",
    "module": "node16",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "../../",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node16",
    "paths": {
      "config/*": ["./src/config/*"],
      "messaging": ["./src/messaging/index.ts"],
      "messaging/*": ["./src/messaging/*"],
      "@trading-model/common/*": ["../../packages/common/src/*"],
      "@trading-model/address-manager": ["../../packages/address-manager/src/index.ts"]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "types": ["node"]
}
