NODE_ENV=production
PORT=8447
TLS_KEY_PATH=server-key.pem
TLS_CERT_PATH=server.crt
TLS_CA_PATH=ca.crt
LOG_LEVEL=info
MONGODB_URI=mongodb://mongo:27017/certificate-authority
CA_KEY_PATH=/etc/ca-keys/ca-key.pem
CA_CERT_TTL_MS=31536000000
CERT_ROTATION_INTERVAL_MS=86400000
CERT_ROTATION_MARGIN_MS=17280000
CERT_DEFAULT_TTL_MS=604800000
DISCOVERY_SERVICE_URL=https://discovery-server:3000
