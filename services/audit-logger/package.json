    "@trading-model/http": "*",
    "@trading-model/persistence": "*",
    "@trading-model/primitives": "*",
    "@trading-model/server-utils": "*",
    "@trading-model/validation": "*",
    "express": "^5.3.0",
    "mongodb": "^7.8.0",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
