# ── Runtime ──────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── TLS / mTLS ──────────────────────────────────────
TLS_KEY_PATH=./certs/server-key.pem
TLS_CERT_PATH=./certs/server.crt
TLS_CA_PATH=./certs/ca.crt

# ── Service Identity ─────────────────────────────────
APP_NAME=job-scheduler
APP_VERSION=1.0.0
SERVICE_NAME=job-scheduler-service
INSTANCE_ID=job-scheduler-1

# ── Certificate Auto-Provisioning (CA client) ───────
# Uncomment to enable automatic TLS certificate bootstrap from the CA:
# CERT_CLIENT_CA_URL=https://certificate-authority:8447
# CERT_CLIENT_SERVICE_ID=job-scheduler
# CERT_CLIENT_COMMON_NAME=job-scheduler
# CERT_CLIENT_SANS=job-scheduler,localhost
# CERT_CLIENT_BOOTSTRAP_TOKEN=

# ── Service Discovery ───────────────────────────────
ADDRESS_MANAGER_URL=https://discovery-server:3000
CACHE_TTL_MS=30000
SERVICE_PING_TIMEOUT_MS=2000
DISCOVERY_TIMEOUT_MS=5000
TOKEN_REFRESH_INTERVAL_MS=60000
TTL_REFRESH_INTERVAL_MS=15000
ERROR_URL_WEBHOOK=
MESSAGE_BUS_INIT_TIMEOUT_MS=2000
MESSAGE_BUS_SHUTDOWN_TIMEOUT_MS=2000
MESSAGE_CALLBACK_PATH=message
DNS_NAME_MAP={}

# ── MongoDB ──────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/job-scheduler

# ── Job Scheduler internals ─────────────────────────
MAX_QUEUE_DEPTH=10000
MAX_WORKER_LOAD_RATIO=0.85
ACK_TIMEOUT_MS=30000
MAX_RETRIES_PER_JOB=3
ORPHAN_SCAN_INTERVAL_MS=10000
WORKER_HEARTBEAT_TTL_MS=30000
