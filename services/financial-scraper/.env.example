# Application
NODE_ENV="development"
APP_NAME="financial-scraper"
APP_VERSION="1.0.0"
PORT=8444
LOG_LEVEL="info"

# TLS / mTLS (SPIRE SVIDs)
TLS_KEY_PATH="/run/spire/svid/svid_key.pem"
TLS_CERT_PATH="/run/spire/svid/svid.pem"
TLS_CA_PATH="/run/spire/svid/bundle.pem"

# Service Identity
SERVICE_NAME="financial-scraper"
INSTANCE_ID="uuid"

# Message Bus
MESSAGE_CALLBACK_PATH="message"

# Database (MySQL)
DB_USER="root"
DB_PASSWORD="changeme"
DB_NAME="financial_scraper"
DB_HOST="localhost"
DB_PORT=3306

# Binance public market data: no account or API key (ADR-0026).
# Never https://data-api.binance.vision in production: its terms forbid live trading (ADR-0077).
# BINANCE_BASE_URL="https://api.binance.com"

# Scraper — SYMBOLS_TO_TRACK takes a JSON array or a CSV list; a malformed value fails startup
SYMBOLS_TO_TRACK='["BTCUSDT","ETHUSDT"]'
SCRAPE_INTERVAL="*/1 * * * *"
# false on HTTP-only replicas (K8s: only financial-scraper-collector runs the cron)
SCRAPE_SCHEDULER_ENABLED=true

# Monitoring
