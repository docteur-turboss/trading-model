{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "node16",
    "outDir": "./dist",
    "rootDir": "./src",
    "moduleResolution": "node16",
    "types": [
      "node"
    ],
    "paths": {
      "config/*": [
        "./src/config/*"
      ]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "tests"
  ]
}
