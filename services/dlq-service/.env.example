# =============================================================================
# DLQ Service — Environment Variables
# =============================================================================

# Service
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
INSTANCE_ID=dlq-1

# TLS (mTLS via SPIRE SVIDs)
TLS_KEY_PATH=/run/spire/svid/svid_key.pem
TLS_CERT_PATH=/run/spire/svid/svid.pem
TLS_CA_PATH=/run/spire/svid/bundle.pem

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=dlq-service

# Redis
REDIS_URL=redis://localhost:6379

# Discovery Server
ADDRESS_MANAGER_URL=https://localhost:8443

# DLQ Configuration
MAX_ENTRIES=100000
DLQ_AUTO_RETRY_ENABLED=false
PRUNE_INTERVAL_MS=86400000
ENTRY_TTL_MS=2592000000

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
