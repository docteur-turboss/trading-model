{
  "__inputs": [],
  "__requires": [],
  "title": "Trader Trainer — Model Training",
  "uid": "trading-trader-trainer",
  "panels": [
    {
      "title": "Training Sessions (Last 24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(tt_training_sessions_total[24h])) by (result)",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "title": "Training Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "max(tt_training_status)",
          "legendFormat": "status"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "value": "0", "text": "IDLE" },
            { "type": "value", "value": "1", "text": "TRAINING" }
          ]
        }
      }
    },
    {
      "title": "Current Generation",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "max(tt_current_generation)",
          "legendFormat": "generation"
        }
      ]
    },
    {
      "title": "Stagnation (generations without improvement)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "max(tt_stagnation_generations)",
          "legendFormat": "generations"
        }
      ]
    },
    {
      "title": "Training Duration (P50 / P95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(tt_training_duration_seconds_bucket[1h])) by (le))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(tt_training_duration_seconds_bucket[1h])) by (le))",
          "legendFormat": "P95"
        }
      ]
    },
    {
      "title": "Best Fitness by Symbol",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "max(tt_best_fitness) by (symbol)",
          "legendFormat": "{{symbol}}"
        }
      ]
    },
    {
      "title": "Market Data Received (candles/s)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum(rate(tt_market_data_received_total[5m]))",
          "legendFormat": "candles/s"
        }
      ]
    },
    {
      "title": "Market Data Buffer by Symbol",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 12 },
      "targets": [
        {
          "expr": "max(tt_market_data_buffer_size) by (symbol)",
          "legendFormat": "{{symbol}}"
        }
      ]
    },
    {
      "title": "Training Errors (per second)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 12 },
      "targets": [
        {
          "expr": "sum(rate(tt_training_sessions_total{result=\"fail\"}[5m])) by (result)",
          "legendFormat": "session {{result}}"
        },
        {
          "expr": "sum(rate(tt_qlearning_train_errors_total[5m])) by (reason)",
          "legendFormat": "q-learning {{reason}}"
        }
      ]
    },
    {
      "title": "Model Artifacts Written",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 18 },
      "targets": [
        {
          "expr": "sum(increase(tt_model_artifacts_total[1h])) by (result)",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "title": "Genome Evaluation P95 (event loop blocked)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(tt_genome_evaluation_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95"
        }
      ]
    },
    {
      "title": "Model Sharpe vs buy and hold (newest stored model, leader)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "max(tt_model_sharpe and on (job, instance) tt_training_leader == 1) by (symbol, segment)",
          "legendFormat": "{{symbol}} model ({{segment}})"
        },
        {
          "expr": "max(tt_model_buy_and_hold_sharpe and on (job, instance) tt_training_leader == 1) by (symbol, segment)",
          "legendFormat": "{{symbol}} buy and hold ({{segment}})"
        },
        {
          "expr": "max(tt_model_below_buy_and_hold_streak and on (job, instance) tt_training_leader == 1) by (symbol)",
          "legendFormat": "{{symbol}} models below in a row"
        }
      ]
    },
    {
      "title": "Model Return and Drawdown (newest stored model, leader)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 24 },
      "targets": [
        {
          "expr": "max(tt_model_return and on (job, instance) tt_training_leader == 1) by (symbol, segment)",
          "legendFormat": "{{symbol}} return ({{segment}})"
        },
        {
          "expr": "max(tt_model_max_drawdown and on (job, instance) tt_training_leader == 1) by (symbol, segment)",
          "legendFormat": "{{symbol}} max drawdown ({{segment}})"
        }
      ]
    },
    {
      "title": "Feature Drift Score (std of the model data, alert above 3)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 24 },
      "targets": [
        {
          "expr": "max(tt_feature_drift_score and on (job, instance) tt_training_leader == 1) by (symbol)",
          "legendFormat": "{{symbol}}"
        }
      ]
    }
  ],
  "tags": ["trading-model", "trader-trainer"],
  "schemaVersion": 39
}
