{
  "dashboard": {
    "uid": "trading-slo",
    "title": "SLO Overview — trading-model",
    "tags": ["slo", "trading-model"],
    "timezone": "browser",
    "editable": true,
    "panels": [
      {
        "title": "Availability SLO — Request Success Rate",
        "type": "bargauge",
        "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "sum(rate(http_requests_duration_seconds_count{status!~\"5..\"}[28d])) / sum(rate(http_requests_duration_seconds_count[28d])) * 100",
            "legendFormat": "Availability"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 95,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "orange", "value": 99.9 },
                { "color": "green", "value": 99.95 }
              ]
            }
          }
        }
      },
      {
        "title": "Latency SLO — P95 Response Time",
        "type": "timeseries",
        "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_requests_duration_seconds_bucket[5m])) by (le))",
            "legendFormat": "P95 Latency"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 2 },
                { "color": "red", "value": 5 }
              ]
            }
          }
        },
        "options": {
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "title": "Error Budget Burn Rate — Fast Burn (5m)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
        "targets": [
          {
            "expr": "rate(http_requests_duration_seconds_count{status=~\"5..\"}[5m]) / rate(http_requests_duration_seconds_count[5m])",
            "legendFormat": "Error Rate (5m)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.02 }]
            }
          }
        }
      },
      {
        "title": "Error Budget Burn Rate — Slow Burn (1h)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
        "targets": [
          {
            "expr": "rate(http_requests_duration_seconds_count{status=~\"5..\"}[1h]) / rate(http_requests_duration_seconds_count[1h])",
            "legendFormat": "Error Rate (1h)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.005 }]
            }
          }
        }
      },
      {
        "title": "Error Budget Remaining",
        "type": "gauge",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
        "targets": [
          {
            "expr": "(1 - sum(rate(http_requests_duration_seconds_count{status=~\"5..\"}[28d])) / sum(rate(http_requests_duration_seconds_count[28d]))) / 0.001 * 100",
            "legendFormat": "Budget %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "orange", "value": 50 },
                { "color": "green", "value": 80 }
              ]
            }
          }
        }
      },
      {
        "title": "Service Uptime",
        "type": "stat",
        "gridPos": { "h": 6, "w": 6, "x": 0, "y": 18 },
        "targets": [
          {
            "expr": "avg(up{job=\"discovery-server\"}) * 100",
            "legendFormat": "discovery-server"
          },
          {
            "expr": "avg(up{job=\"message-manager\"}) * 100",
            "legendFormat": "message-manager"
          },
          {
            "expr": "avg(up{job=\"api-gateway\"}) * 100",
            "legendFormat": "api-gateway"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 99.9 }]
            }
          }
        }
      },
      {
        "title": "P95 Latency by Service",
        "type": "table",
        "gridPos": { "h": 6, "w": 10, "x": 6, "y": 18 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_requests_duration_seconds_bucket[5m])) by (le, job))",
            "format": "table",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          },
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "Value" },
              "properties": [{ "id": "unit", "value": "s" }]
            }
          ]
        }
      },
      {
        "title": "Circuit Breaker Status",
        "type": "stat",
        "gridPos": { "h": 6, "w": 8, "x": 16, "y": 18 },
        "targets": [
          {
            "expr": "circuit_breaker_state",
            "legendFormat": "{{service}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              { "type": "value", "value": "0", "text": "CLOSED" },
              { "type": "value", "value": "1", "text": "OPEN" },
              { "type": "value", "value": "2", "text": "HALF-OPEN" }
            ],
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }]
            }
          }
        }
      },
      {
        "title": "Backpressure Ratio",
        "type": "timeseries",
        "gridPos": { "h": 6, "w": 12, "x": 0, "y": 24 },
        "targets": [
          {
            "expr": "message_manager_backpressure_ratio",
            "legendFormat": "Backpressure"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 0.6 },
                { "color": "red", "value": 0.8 }
              ]
            }
          }
        }
      },
      {
        "title": "DLQ Growth Rate",
        "type": "timeseries",
        "gridPos": { "h": 6, "w": 12, "x": 12, "y": 24 },
        "targets": [
          {
            "expr": "rate(dlq_entries_added_total[15m])",
            "legendFormat": "Added"
          },
          {
            "expr": "rate(dlq_entries_replayed_total[15m])",
            "legendFormat": "Replayed"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "rps"
          }
        }
      }
    ],
    "time": { "from": "now-1h", "to": "now" }
  }
}
