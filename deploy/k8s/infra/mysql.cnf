[mysqld]
# Per-pod values (server_id) are passed as mysqld arguments by the StatefulSet: a .cnf is not expanded.
binlog-format=ROW
# 4 days: the 72 h of local archives (ADR-0031) plus a day of margin; the 30-day default fills the 20Gi volume.
binlog_expire_logs_seconds=345600
log-bin=mysql-bin
relay-log=mysql-relay
relay-log-recovery=ON
enforce-gtid-consistency=ON
gtid-mode=ON
# Client TLS (issue #767, ADR-0060): certificate of mysql-tls.yaml. TCP
# connections without TLS are refused (the local socket of kubectl exec,
# backups and restores is not concerned); the user must also present its
# client certificate (REQUIRE ISSUER / SUBJECT, db-migrate-user).
require_secure_transport=ON
ssl-ca=/etc/mysql-tls/ca.crt
ssl-cert=/etc/mysql-tls/tls.crt
ssl-key=/etc/mysql-tls/tls.key
tls-version=TLSv1.2,TLSv1.3
# Encryption at rest (GDPR Art. 32) is NOT configured here: the former
# innodb_encrypt_* / encrypt-binlog options are MariaDB-only and made
# MySQL abort. MySQL needs a keyring component (component_keyring_file
# with its manifest) before default_table_encryption / binlog_encryption.
