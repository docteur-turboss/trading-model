{
  "__inputs": [],
  "__requires": [],
  "title": "Trading Model — Services Overview",
  "uid": "trading-services",
  "annotations": { "list": [ { "name": "Deploys", "enable": true, "iconColor": "blue", "expr": "count by (service, version) (build_info) unless count by (service, version) (build_info offset 5m)", "titleFormat": "Deploy", "textFormat": "{{service}} {{version}}", "step": "60s" } ] },
  "panels": [
    {
      "title": "Service Health",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "count(up{job=~\"api-gateway|audit-logger|financial-scraper.*|model-evaluator|decision-consumer|risk-execution|trader-trainer\"} == 1)",
          "legendFormat": "Healthy"
        },
        {
          "expr": "count(up{job=~\"api-gateway|audit-logger|financial-scraper.*|model-evaluator|decision-consumer|risk-execution|trader-trainer\"} == 0)",
          "legendFormat": "Unhealthy"
        }
      ]
    },
    {
      "title": "HTTP Request Rate by Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (job)",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "title": "P99 Latency by Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{path!~\"/ping|/health/ready|/metrics\"}[5m])) by (le, job))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "title": "TLS Certificate Expiry (seconds left, blackbox probes)",
      "type": "table",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 12 },
      "targets": [
        {
          "expr": "probe_ssl_earliest_cert_expiry - time()",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "title": "Error Rate by Service (5m)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 12 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) by (job) / sum(rate(http_requests_total[5m])) by (job)",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "title": "Scrape Cycles by Result",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 18 },
      "targets": [
        {
          "expr": "sum(rate(fs_scrape_cycles_total[5m])) by (result)",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "title": "Candles Persisted (per second)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 18 },
      "targets": [
        {
          "expr": "sum(rate(fs_candles_persisted_total[5m]))",
          "legendFormat": "candles/s"
        }
      ]
    },
    {
      "title": "Symbols Failed (per second)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 18 },
      "targets": [
        {
          "expr": "sum(rate(fs_symbols_failed_total[5m]))",
          "legendFormat": "failed/s"
        }
      ]
    },
    {
      "title": "Audit Chain Broken",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "max(audit_chain_broken)",
          "legendFormat": "broken"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "value": "0", "text": "OK" },
            { "type": "value", "value": "1", "text": "BROKEN" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }]
          }
        }
      }
    },
    {
      "title": "Audit Chain Verification / Anchor Age",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 10, "x": 4, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "time() - max(audit_chain_last_verification_timestamp)",
          "legendFormat": "since last verification"
        },
        {
          "expr": "time() - max(audit_chain_last_anchor_timestamp)",
          "legendFormat": "since last anchor"
        }
      ]
    },
    {
      "title": "Audit Chain Verified / Anchored Sequence",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 10, "x": 14, "y": 24 },
      "targets": [
        {
          "expr": "max(audit_chain_verified_sequence)",
          "legendFormat": "verified"
        },
        {
          "expr": "max(audit_chain_anchored_sequence)",
          "legendFormat": "anchored"
        }
      ]
    },
    {
      "title": "Gateway P95 Latency by Target Service",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 30 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(gw_proxy_request_duration_seconds_bucket[5m])) by (le, service))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "title": "Gateway Upstream Errors by Target Service (per second)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 30 },
      "targets": [
        {
          "expr": "sum(rate(gw_service_errors_total[5m])) by (service)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "title": "Signal Sources in Quarantine / Disabled",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 30 },
      "targets": [
        {
          "expr": "fs_signal_source_quarantined == 1",
          "legendFormat": "quarantined {{source}}"
        },
        {
          "expr": "fs_signal_source_disabled == 1",
          "legendFormat": "disabled {{source}} ({{reason}})"
        }
      ]
    },
    {
      "title": "Signal Source Requests per Day (planned)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 36 },
      "targets": [
        {
          "expr": "fs_signal_source_daily_requests",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "title": "Signal Source Newest Data Age (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 36 },
      "targets": [
        {
          "expr": "time() - fs_signal_newest_observed_timestamp_seconds",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "title": "Container CPU usage vs requests (cores)",
      "description": "Kubernetes only (cAdvisor + kube-state-metrics); compose has neither.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 42 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "expr": "sum by (container) (rate(container_cpu_usage_seconds_total{container!=\"\"}[5m]))", "legendFormat": "{{container}} usage" },
        { "expr": "sum by (container) (kube_pod_container_resource_requests{resource=\"cpu\"})", "legendFormat": "{{container}} request" }
      ]
    },
    {
      "title": "Container memory usage vs requests",
      "description": "Kubernetes only (cAdvisor + kube-state-metrics); compose has neither.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 42 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "expr": "sum by (container) (container_memory_working_set_bytes{container!=\"\"})", "legendFormat": "{{container}} usage" },
        { "expr": "sum by (container) (kube_pod_container_resource_requests{resource=\"memory\"})", "legendFormat": "{{container}} request" }
      ]
    }
  ],
  "tags": ["trading-model", "production"],
  "schemaVersion": 39
}
